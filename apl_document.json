{
  "type": "APL",
  "version": "2023.3",
  "theme": "dark",
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#0a0e0f",
        "paddingLeft": 40,
        "paddingRight": 40,
        "paddingTop": 30,
        "items": [
          {
            "type": "Text",
            "text": "VISION STICK — LIVE TELEMETRY",
            "color": "#6f8a86",
            "fontSize": "20dp",
            "letterSpacing": "2px"
          },
          {
            "type": "Frame",
            "borderRadius": 8,
            "backgroundColor": "#10161a",
            "borderColor": "${payload.dashboardData.properties.status == 'PATH CLEAR' ? '#2a5c42' : '#ffb454'}",
            "borderWidth": 1,
            "marginTop": 16,
            "padding": 16,
            "items": [
              {
                "type": "Text",
                "text": "STATUS: ${payload.dashboardData.properties.status}",
                "color": "${payload.dashboardData.properties.status == 'PATH CLEAR' ? '#5eff9a' : '#ffb454'}",
                "fontSize": "28dp",
                "fontWeight": "700"
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "marginTop": 20,
            "items": [
              {
                "type": "Frame",
                "flex": 1,
                "marginRight": 10,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "LEFT", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.left} cm", "color": "#5eff9a", "fontSize": "32dp", "fontWeight": "700" }
                ]
              },
              {
                "type": "Frame",
                "flex": 1,
                "marginRight": 10,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "FRONT", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.front} cm", "color": "#5eff9a", "fontSize": "32dp", "fontWeight": "700" }
                ]
              },
              {
                "type": "Frame",
                "flex": 1,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "RIGHT", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.right} cm", "color": "#5eff9a", "fontSize": "32dp", "fontWeight": "700" }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "marginTop": 14,
            "items": [
              {
                "type": "Frame",
                "flex": 1,
                "marginRight": 10,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "TEMP", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.temp}°C", "color": "#6fd6ff", "fontSize": "24dp", "fontWeight": "700" }
                ]
              },
              {
                "type": "Frame",
                "flex": 1,
                "marginRight": 10,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "HUMIDITY", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.hum}%", "color": "#6fd6ff", "fontSize": "24dp", "fontWeight": "700" }
                ]
              },
              {
                "type": "Frame",
                "flex": 1,
                "backgroundColor": "#10161a",
                "borderRadius": 6,
                "padding": 14,
                "items": [
                  { "type": "Text", "text": "DEPTH / BASE", "color": "#6f8a86", "fontSize": "14dp" },
                  { "type": "Text", "text": "${payload.dashboardData.properties.depth}mm / ${payload.dashboardData.properties.baseline}", "color": "#ffb454", "fontSize": "20dp", "fontWeight": "700" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
